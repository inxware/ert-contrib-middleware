# Dockerfile.debian12-clang14
#
# Lean build environment for ert-contrib-middleware x86_64 Debian 12 builds.
# Produces image: inxware/inx-debian12-clang14
#
# This image is shared by any ert-contrib-middleware build that targets
# x86_64 Debian 12 (clang 14 default toolchain) — it is not tied to any
# specific ert-components platform.
#
# To build:
#   cd inx_build_scripts
#   docker build -f Dockerfile.debian12-clang14 -t inxware/inx-debian12-clang14 .

FROM debian:12

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    clang \
    llvm \
    lld \
    git \
    git-lfs \
    rsync \
    wget \
    curl \
    ca-certificates \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
