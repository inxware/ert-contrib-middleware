s2n_mem_allocator_test: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 s2n_mem_allocator_test
.PHONY : s2n_mem_allocator_test

# fast build rule for target.
s2n_mem_allocator_test/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/s2n_mem_allocator_test.dir/build.make CMakeFiles/s2n_mem_allocator_test.dir/build
.PHONY : s2n_mem_allocator_test/fast

