prefix=/mingw64
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango FT2 and Pango Fc
Description: FreeType 2.0 and fontconfig font support for Pango
Version: 1.58.2
Requires: pango, freetype2, fontconfig >=  2.17.0
Requires.private: glib-2.0 >=  2.88, gobject-2.0 >=  2.88, gio-2.0 >=  2.88, fribidi >=  1.0.6, libthai >=  0.1.9, harfbuzz >=  11.0.0, cairo >=  1.18.0, harfbuzz-gobject >=  11.0.0
Libs: -L${libdir} -lpangoft2-1.0
Libs.private: -lm
Cflags: -I${includedir}/pango-1.0
