prefix=/mingw64
includedir=${prefix}/include
libdir=${prefix}/lib

p11_module_configs=/mingw64/share/p11-kit/modules
p11_module_path=/mingw64/lib/pkcs11
proxy_module=/mingw64/lib/p11-kit-proxy.dll
p11_system_config_modules=/mingw64/share/p11-kit/modules
p11_trust_paths=/mingw64/etc/pki/ca-trust/source:/mingw64/share/pki/ca-trust-source

Name: p11-kit
Description: Library and proxy module for properly loading and sharing PKCS#11 modules.
Version: 0.26.5
Libs: -L${libdir} -lp11-kit
Cflags: -I${includedir}/p11-kit-1
